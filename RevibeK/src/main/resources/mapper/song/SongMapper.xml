<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.revibek.song.mapper.SongDao">

    <resultMap id="SongResultMap" type="com.ssafy.revibek.song.dto.SongDto">
        <id     property="id"              column="id"/>
        <result property="title"           column="title"/>
        <result property="artist"          column="artist"/>
        <result property="genre"           column="genre"/>
        <result property="era"             column="era"/>
        <result property="generation"      column="generation"/>
        <result property="mood"            column="mood"/>
        <result property="type"            column="type"/>
        <result property="youtubeUrl"      column="youtube_url"/>
        <result property="youtubeId"       column="youtube_id"/>
        <result property="thumbnailUrl"    column="thumbnail_url"/>
        <result property="viewCount"       column="view_count"/>
        <result property="likeCount"       column="like_count"/>
        <result property="trendScore"      column="trend_score"/>
        <result property="score"           column="score"/>
        <result property="scoreUpdatedAt"  column="score_updated_at"/>
        <result property="releasedAt"      column="released_at"/>
        <result property="createdAt"       column="created_at"/>
        <result property="durationSeconds"  column="duration_seconds"/>
        <result property="bpm"              column="bpm"/>
        <result property="energy"           column="energy"/>
        <result property="danceability"     column="danceability"/>
        <result property="loudness"         column="loudness"/>
        <result property="musicalKey"       column="musical_key"/>
        <result property="musicalScale"     column="musical_scale"/>
        <result property="beatsCount"       column="beats_count"/>
        <result property="beatsConfidence"  column="beats_confidence"/>
        <result property="keyStrength"      column="key_strength"/>
        <result property="spectralCentroid" column="spectral_centroid"/>
        <result property="zeroCrossingRate" column="zero_crossing_rate"/>
        <result property="isAnalyzed"       column="is_analyzed"/>
        <result property="updatedAt"        column="updated_at"/>
    </resultMap>

    <resultMap id="RadioRecommendationSongResultMap" type="com.ssafy.revibek.song.dto.SongDto">
        <id     property="id"         column="id"/>
        <result property="title"      column="title"/>
        <result property="artist"     column="artist"/>
        <result property="genre"      column="genre"/>
        <result property="era"        column="era"/>
        <result property="generation" column="generation"/>
        <result property="youtubeUrl" column="youtube_url"/>
        <result property="youtubeId"  column="youtube_id"/>
        <result property="thumbnailUrl" column="thumbnail_url"/>
        <result property="score"      column="score"/>
    </resultMap>

    <insert id="insertSong" parameterType="com.ssafy.revibek.song.dto.SongDto">
        INSERT INTO songs (
            id, title, artist, genre, era, generation, mood, type,
            youtube_url, youtube_id, thumbnail_url,
            view_count, like_count,
            trend_score, score,
            released_at, created_at,
            duration_seconds, bpm, energy,
            danceability, loudness,
            musical_key, musical_scale,
            beats_count, beats_confidence, key_strength,
            spectral_centroid, zero_crossing_rate, is_analyzed
        ) VALUES (
            UUID(), #{title}, #{artist}, #{genre}, #{era}, #{generation}, #{mood}, #{type},
            #{youtubeUrl}, #{youtubeId}, #{thumbnailUrl},
            #{viewCount}, #{likeCount},
            #{trendScore}, #{score},
            #{releasedAt}, NOW(),
            #{durationSeconds}, #{bpm}, #{energy},
            #{danceability}, #{loudness},
            #{musicalKey}, #{musicalScale},
            #{beatsCount}, #{beatsConfidence}, #{keyStrength},
            #{spectralCentroid}, #{zeroCrossingRate}, #{isAnalyzed}
        )
    </insert>

    <select id="selectAllSongs" resultMap="SongResultMap">
        SELECT * FROM songs ORDER BY created_at DESC
    </select>

    <select id="selectSongById" parameterType="String" resultMap="SongResultMap">
        SELECT * FROM songs WHERE id = #{id}
    </select>

    <select id="selectSongByYoutubeId" parameterType="String" resultMap="SongResultMap">
        SELECT * FROM songs WHERE youtube_id = #{youtubeId}
    </select>

    <select id="selectSongByTitle" parameterType="String" resultMap="SongResultMap">
        SELECT * FROM songs
        WHERE title LIKE CONCAT('%', #{title}, '%')
        ORDER BY score DESC
    </select>

    <select id="selectSongsByGenre" parameterType="String" resultMap="SongResultMap">
        SELECT * FROM songs WHERE genre = #{genre} ORDER BY score DESC
    </select>

    <select id="selectRecommendSongs" resultMap="SongResultMap">
        SELECT * FROM songs ORDER BY score DESC LIMIT 10
    </select>

    <sql id="RadioRecommendationColumns">
        id,
        title,
        artist,
        genre,
        era,
        generation,
        youtube_url,
        youtube_id,
        thumbnail_url,
        score
    </sql>

    <sql id="ExcludedKeywordCondition">
        <if test="excludedKeywords != null and excludedKeywords != ''">
            AND LOWER(CONCAT(title, ' ', artist)) NOT REGEXP LOWER(REPLACE(#{excludedKeywords}, ',', '|'))
        </if>
    </sql>

    <select id="findRecommendedSongsByMoodEraGenre" resultMap="RadioRecommendationSongResultMap">
        SELECT
            <include refid="RadioRecommendationColumns"/>
        FROM songs
        WHERE mood = #{mood}
          AND (era = #{era} OR generation = #{generation})
          AND genre = #{genre}
          <include refid="ExcludedKeywordCondition"/>
        ORDER BY score DESC, created_at DESC
        LIMIT #{limit}
    </select>

    <select id="findRecommendedSongsByMoodEra" resultMap="RadioRecommendationSongResultMap">
        SELECT
            <include refid="RadioRecommendationColumns"/>
        FROM songs
        WHERE mood = #{mood}
          AND (era = #{era} OR generation = #{generation})
          <include refid="ExcludedKeywordCondition"/>
        ORDER BY score DESC, created_at DESC
        LIMIT #{limit}
    </select>

    <select id="findRecommendedSongsByMoodGenre" resultMap="RadioRecommendationSongResultMap">
        SELECT
            <include refid="RadioRecommendationColumns"/>
        FROM songs
        WHERE mood = #{mood}
          AND genre = #{genre}
          <include refid="ExcludedKeywordCondition"/>
        ORDER BY score DESC, created_at DESC
        LIMIT #{limit}
    </select>

    <select id="findRecommendedSongsByMood" resultMap="RadioRecommendationSongResultMap">
        SELECT
            <include refid="RadioRecommendationColumns"/>
        FROM songs
        WHERE mood = #{mood}
          <include refid="ExcludedKeywordCondition"/>
        ORDER BY score DESC, created_at DESC
        LIMIT #{limit}
    </select>

    <select id="findRecommendedSongsByEraAndGenre" resultMap="RadioRecommendationSongResultMap">
        SELECT
            <include refid="RadioRecommendationColumns"/>
        FROM songs
        WHERE (era = #{era} OR generation = #{generation})
          AND genre = #{genre}
          <include refid="ExcludedKeywordCondition"/>
        ORDER BY score DESC, created_at DESC
        LIMIT #{limit}
    </select>

    <select id="findRecommendedSongsByEra" resultMap="RadioRecommendationSongResultMap">
        SELECT
            <include refid="RadioRecommendationColumns"/>
        FROM songs
        WHERE (era = #{era} OR generation = #{generation})
          <include refid="ExcludedKeywordCondition"/>
        ORDER BY score DESC, created_at DESC
        LIMIT #{limit}
    </select>

    <select id="findRecommendedSongsByGenre" resultMap="RadioRecommendationSongResultMap">
        SELECT
            <include refid="RadioRecommendationColumns"/>
        FROM songs
        WHERE genre = #{genre}
          <include refid="ExcludedKeywordCondition"/>
        ORDER BY score DESC, created_at DESC
        LIMIT #{limit}
    </select>

    <select id="findRecommendedSongsByPreference" resultMap="RadioRecommendationSongResultMap">
        SELECT
            <include refid="RadioRecommendationColumns"/>
        FROM songs
        <where>
            <trim prefix="(" suffix=")" prefixOverrides="OR">
                <if test="moods != null and moods.size() > 0">
                    OR mood IN
                    <foreach collection="moods" item="item" open="(" separator="," close=")">
                        #{item}
                    </foreach>
                </if>
                <if test="generations != null and generations.size() > 0">
                    OR generation IN
                    <foreach collection="generations" item="item" open="(" separator="," close=")">
                        #{item}
                    </foreach>
                </if>
                <if test="eras != null and eras.size() > 0">
                    OR era IN
                    <foreach collection="eras" item="item" open="(" separator="," close=")">
                        #{item}
                    </foreach>
                </if>
                <if test="genres != null and genres.size() > 0">
                    OR genre IN
                    <foreach collection="genres" item="item" open="(" separator="," close=")">
                        #{item}
                    </foreach>
                </if>
                <if test="artists != null and artists.size() > 0">
                    OR artist IN
                    <foreach collection="artists" item="item" open="(" separator="," close=")">
                        #{item}
                    </foreach>
                </if>
            </trim>
            <include refid="ExcludedKeywordCondition"/>
        </where>
        ORDER BY score DESC, created_at DESC
        LIMIT #{limit}
    </select>

    <select id="findTopScoreSongs" resultMap="RadioRecommendationSongResultMap">
        SELECT
            <include refid="RadioRecommendationColumns"/>
        FROM songs
        ORDER BY score DESC, created_at DESC
        LIMIT #{limit}
    </select>

    <update id="updateSong" parameterType="com.ssafy.revibek.song.dto.SongDto">
        UPDATE songs
        SET
            title            = #{title},
            artist           = #{artist},
            genre            = #{genre},
            era              = #{era},
            generation       = #{generation},
            mood             = #{mood},
            type             = #{type},
            youtube_url      = #{youtubeUrl},
            youtube_id       = #{youtubeId},
            thumbnail_url    = #{thumbnailUrl},
            view_count       = #{viewCount},
            like_count       = #{likeCount},
            trend_score      = #{trendScore},
            score            = #{score},
            score_updated_at = NOW(),
            released_at      = #{releasedAt},
            duration_seconds = #{durationSeconds},
            bpm              = #{bpm},
            energy           = #{energy},
            danceability     = #{danceability},
            loudness         = #{loudness},
            musical_key      = #{musicalKey},
            musical_scale    = #{musicalScale},
            beats_count      = #{beatsCount},
            beats_confidence = #{beatsConfidence},
            key_strength     = #{keyStrength},
            spectral_centroid = #{spectralCentroid},
            zero_crossing_rate = #{zeroCrossingRate},
            is_analyzed      = #{isAnalyzed}
        WHERE id = #{id}
    </update>

    <delete id="deleteSong" parameterType="String">
        DELETE FROM songs WHERE id = #{id}
    </delete>

</mapper>
