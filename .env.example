# 이 파일을 .env로 복사한 뒤 실제 값을 채워서 사용한다 (.env는 git에 올리지 않음)
# cp .env.example .env

# ── MySQL ──
MYSQL_ROOT_PASSWORD=changeme-root
DB_USERNAME=SSAFY
DB_PASSWORD=changeme

# ── JWT ──
JWT_SECRET=changeme-32bytes-minimum-secret-key

# ── CORS / 공개 도메인 (운영 도메인으로 교체) ──
CORS_ALLOWED_ORIGINS=http://localhost
OAUTH_FRONTEND_REDIRECT_URL=http://localhost
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# ── Google OAuth2 ──
# GOOGLE_OAUTH_ENABLED=false여도 client-id가 빈 문자열이면 Spring Boot OAuth2Client
# 자동설정이 부팅 시점 검증에서 실패해 컨테이너가 죽는다. 실제 로그인을 안 쓰더라도
# 비어있지 않은 값(placeholder 가능)을 넣어야 한다.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=disabled-placeholder-client-id
GOOGLE_CLIENT_SECRET=disabled-placeholder-client-secret

# ── GMS (Claude/GPT 프록시) ──
GMS_KEY=
GMS_OPENAI_ENABLED=false
GMS_MODEL=gpt-4.1-nano

# ── YouTube Data API ──
YOUTUBE_ENABLED=true
YOUTUBE_API_KEY=

# ── Spotify (era/generation 보강, 기본 비활성화) ──
SPOTIFY_ENABLED=false
CLIENT_ID=
CLIENT_SECRET=

# ── Google Cloud TTS (기본 비활성화) ──
TTS_ENABLED=false
GCP_TTS_API_KEY=

# ── Gmail SMTP (기본 mock 모드 — 비워두면 인증코드는 콘솔 로그로만 출력) ──
EMAIL_VERIFICATION_MODE=mock
SMTP_USERNAME=
SMTP_PASSWORD=

# ── FastAPI / Qdrant 연동 (기본값 그대로 — compose 서비스명 사용) ──
FASTAPI_ENABLED=true
QDRANT_ENABLED=true
