# 이 파일을 .env로 복사한 뒤 실제 값을 채워서 사용한다 (.env는 git에 올리지 않음)
# cp .env.example .env

# ── MySQL ──
MYSQL_ROOT_PASSWORD=changeme-root
DB_USERNAME=SSAFY
DB_PASSWORD=changeme

# ── JWT ──
JWT_SECRET=changeme-32bytes-minimum-secret-key

# ── CORS / 공개 도메인 (운영 도메인으로 교체) ──
CORS_ALLOWED_ORIGINS=http://localhost
OAUTH_FRONTEND_REDIRECT_URL=http://localhost
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# ── Swagger UI (운영 배포 시 false로 변경해 외부 노출 차단) ──
SWAGGER_ENABLED=true

# ── Google OAuth2 ──
# GOOGLE_OAUTH_ENABLED=false여도 client-id가 빈 문자열이면 Spring Boot OAuth2Client
# 자동설정이 부팅 시점 검증에서 실패해 컨테이너가 죽는다. 실제 로그인을 안 쓰더라도
# 비어있지 않은 값(placeholder 가능)을 넣어야 한다.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=disabled-placeholder-client-id
GOOGLE_CLIENT_SECRET=disabled-placeholder-client-secret

# ── GMS (Claude/GPT 프록시) ──
# GMS_ENABLED=true + GMS_KEY가 모두 있어야 Claude 기반 DJ 멘트 생성이 실제로 호출된다.
# 비활성/누락 시 라디오 생성은 실패하지 않고 하드코딩된 fallback 멘트를 사용한다.
GMS_ENABLED=true
GMS_KEY=
# SSAFY GMS 프록시는 모델 allowlist가 있어 일부 모델명은 400으로 거부된다.
# 실제 호출로 확인된 사용 가능 모델: claude-sonnet-4-5-20250929, claude-haiku-4-5-20251001
# (claude-3-7-sonnet-latest 등 구버전 alias/3.x/4.0 계열은 거부됨)
GMS_CLAUDE_MODEL=claude-sonnet-4-5-20250929
GMS_OPENAI_ENABLED=false
GMS_MODEL=gpt-4.1-nano

# ── YouTube Data API ──
YOUTUBE_ENABLED=true
YOUTUBE_API_KEY=

# ── Spotify (era/generation 보강, 기본 비활성화) ──
SPOTIFY_ENABLED=false
CLIENT_ID=
CLIENT_SECRET=

# ── Google Cloud TTS (기본 비활성화) ──
# TTS_ENABLED=true + GCP_TTS_API_KEY가 모두 있어야 실제 Google TTS 음성 합성이 호출된다.
# 비활성/누락/실패 시 브라우저 Web Speech API(BROWSER_TTS) fallback이 사용된다.
TTS_ENABLED=false
GCP_TTS_API_KEY=
# 아래 값은 비워두면 GoogleTtsService의 기본값(ko-KR / ko-KR-Chirp3-HD-Vindemiatrix / MP3 / 1.0)을 사용한다.
TTS_LANGUAGE_CODE=ko-KR
TTS_VOICE=ko-KR-Chirp3-HD-Vindemiatrix
TTS_AUDIO_ENCODING=MP3
TTS_SPEAKING_RATE=1.0
TTS_PITCH=0.0

# ── Gmail SMTP (기본 mock 모드 — 비워두면 인증코드는 콘솔 로그로만 출력) ──
EMAIL_VERIFICATION_MODE=mock
SMTP_USERNAME=
SMTP_PASSWORD=

# ── FastAPI / Qdrant 연동 (기본값 그대로 — compose 서비스명 사용) ──
FASTAPI_ENABLED=true
QDRANT_ENABLED=true
# true로 두면 backend 기동 시마다(docker compose up) 임베딩 생성 + Qdrant upsert를 자동 실행한다.
AUTO_SYNC_QDRANT_ON_STARTUP=false
